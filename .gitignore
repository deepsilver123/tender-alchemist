/*
!.gitignore
!/README.md
!/requirements.txt
!/src/
!/src/**
!/data/
!/data/**
!/scripts/
!/scripts/**
!/deploy/
!/deploy/**
!/docker-compose.yml
!/.dockerignore
!/.env.example
!/searxng/
!/searxng/**

# Ignore Python cache inside allowed dirs
# Ignore Python bytecode and cache
__pycache__/
**/__pycache__/
*.py[cod]

src/**/__pycache__/
src/**/*.pyc
data/**/__pycache__/
data/**/*.pyc

# Common things to ignore
.venv/
venv/
logs/
*.log
.env
.DS_Store
.vscode/
.idea/
Thumbs.db
!.vscode/settings.json

# Local artifacts (ignore large generated files & secrets)
data/uploads/
data/downloads/
data/e2e4/
data/e2e4_extracted/
data/enriched/
data/qdrant_db/
data/raw_catalogs/
data/state.json
data/batch_report.json
# Duplicate hash-prefixed catalogs
data/catalogs/*_e2e4_flat.csv
results/
.pytest_cache/
.mypy_cache/
html-samples/
show_qdrant_samples.py
