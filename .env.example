# ── Tender Alchemist — Environment Variables ─────────────────────────────────
# Copy to .env and adjust as needed:
#   cp .env.example .env

# ── Web UI ──
WEBUI_PORT=8000

# ── Ollama (LLM) ──
OLLAMA_PORT=11434

# ── Docling (document conversion) ──
DOCLING_PORT=5001

# ── Open Icecat (product enrichment) ──
# Бесплатная регистрация: https://icecat.biz/registration/
ICECAT_USER=your_icecat_username@example.com
ICECAT_PASSWORD=your_icecat_password
ICECAT_LANG=RU
