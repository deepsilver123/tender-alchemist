# ── Tender Alchemist — Переменные окружения ──────────────────────────────────
# Скопируйте в .env и настройте под вашу среду:
#   cp .env.example .env

# ── Веб-интерфейс ──
WEBUI_PORT=8000

# ── Ollama (LLM) ──
OLLAMA_PORT=11434

# ── Docling (конвертация документов) ──
DOCLING_PORT=5001

# ── LLM-модели ──
LLM_MODEL=ministral-3:3b
LLM_QUERY_MODEL=qwen2.5:1.5b

# ── FastEmbed (локальные эмбеддинги) ──
DENSE_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL_NAME=Qdrant/bm42-all-minilm-l6-v2-attentions

# ── Qdrant ──
QDRANT_COLLECTION_NAME=e2e4_catalog

# ── Каталог e2e4 ──
E2E4_CATALOG_URL=https://e2e4online.ru/ws/excel/irkutsk.e2e4online.ru.zip

# ── Поиск ──
SEARCH_MAX_RESULTS=10

# ── Временная зона ──
TZ=Asia/Irkutsk
